---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Main from "./Main.astro";
import ReviewCard from "./ReviewCard.astro";
import ReviewFilters from "./ReviewFilters.astro";
import type { ReviewType } from "@/utils/reviewTypes";
import { useTranslations } from "@/i18n";
import config from "@/config";
type Props = { page: Page<CollectionEntry<"reviews">>; types: ReviewType[]; selected?: ReviewType };
const { page, types, selected } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---
<Layout title={`${t.pages.reviewsTitle} | ${config.site.title}`} description={t.pages.reviewsDesc}>
  <Header />
  <Main pageTitle={t.pages.reviewsTitle} pageDesc={t.pages.reviewsDesc} class="mt-8">
    <ReviewFilters {types} {selected} />
    <ul class="radar-review-list">{page.data.map(review => <ReviewCard {review} />)}</ul>
    {page.data.length === 0 && <p>Разборов пока нет.</p>}
    {page.lastPage > 1 && <nav class="radar-pagination" aria-label="Pagination Navigation">
      {page.url.prev && <a class="radar-btn" href={page.url.prev}>{t.pagination.prev}</a>}
      <span>{page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a class="radar-btn" href={page.url.next}>{t.pagination.next}</a>}
    </nav>}
  </Main>
  <Footer />
</Layout>
