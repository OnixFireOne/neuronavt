---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import ReviewList from "@/components/ReviewList.astro";
import { getSortedReviews } from "@/utils/getSortedReviews";
import { reviewTypeKeys } from "@/utils/reviewTypes";
import config from "@/config";
export const getStaticPaths = (async ({ paginate }) => {
  const reviews = getSortedReviews(await getCollection("reviews"));
  const types = reviewTypeKeys.filter(type => reviews.some(review => review.data.content_type === type));
  return paginate(reviews, { pageSize: config.posts.perPage, props: { types } });
}) satisfies GetStaticPaths;
---
<ReviewList {...Astro.props} />
